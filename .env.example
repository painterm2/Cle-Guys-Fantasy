# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your values. NEVER commit .env.local
# — it holds your private ESPN session cookies.
# ---------------------------------------------------------------------------

# Your ESPN league id (the number in your league URL: .../leagues/XXXXXXX).
# Defaults to the Cleveland Guys league if omitted.
ESPN_LEAGUE_ID=2110005

# Season year. Omit to auto-detect the current NFL season.
# ESPN_SEASON=2026

# ---- PRIVATE LEAGUE COOKIES (required because this league needs a login) ----
# Grab these from a browser where you're logged into ESPN:
#   1. Go to https://fantasy.espn.com and log in.
#   2. Open DevTools (F12) > Application > Cookies > https://fantasy.espn.com
#   3. Copy the VALUE of `espn_s2` into ESPN_S2 below.
#   4. Copy the VALUE of `SWID` (including the { } braces) into ESPN_SWID below.
# These are secrets — keep them out of git and set them in Vercel as
# encrypted Environment Variables.
ESPN_S2=
ESPN_SWID=

# Optional: expose the league id to the browser for the "Open in ESPN" links.
# NEXT_PUBLIC_ESPN_LEAGUE_ID=2110005
